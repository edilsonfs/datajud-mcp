# =====================================================================
# datajud-mcp — modelo de configuração
# =====================================================================
#
# COMO USAR
#   1. Copie este arquivo para ".env" na mesma pasta:
#        Windows:      copy .env.example .env
#        macOS/Linux:  cp .env.example .env
#   2. Preencha apenas os campos que você for usar.
#   3. NUNCA envie o ".env" para o GitHub — ele já está no .gitignore.
#      Este ".env.example" é que vai versionado, e por isso precisa
#      ficar sempre sem valores reais.
#
# IMPORTANTE
#   O servidor NÃO lê este arquivo sozinho. Ele lê variáveis de
#   ambiente. Cada bloco abaixo explica onde o valor precisa ser
#   colocado de fato para ter efeito.
#
# ---------------------------------------------------------------------


# =====================================================================
# 1. API DataJud do CNJ  —  OPCIONAL
# =====================================================================
# O servidor já funciona sem nada aqui: a chave pública do CNJ vem
# embutida no pacote. Só preencha se o CNJ rotacionar a chave e o
# servidor começar a responder "A API do CNJ recusou a chave de acesso".
#
# Onde pegar a chave nova:
#   https://datajud-wiki.cnj.jus.br/api-publica/acesso
#
# Onde este valor precisa ser colocado para funcionar de verdade:
#   No Claude Desktop, dentro do claude_desktop_config.json:
#     "datajud": { "command": "datajud-mcp",
#                  "env": { "DATAJUD_API_KEY": "cole-aqui" } }
#   No terminal (macOS/Linux):  export DATAJUD_API_KEY="cole-aqui"
#   No terminal (Windows):      set DATAJUD_API_KEY=cole-aqui

DATAJUD_API_KEY=

# Tempo limite de cada consulta à API, em segundos. Padrão: 45.
# Aumente se sua conexão for lenta ou se fizer extrações muito grandes.
DATAJUD_TIMEOUT=


# =====================================================================
# 2. Publicação de novas versões no PyPI  —  OPCIONAL
# =====================================================================
# Só é necessário quando você for publicar uma versão nova do pacote
# (1.0.1, 1.1.0 etc). Não tem relação com o uso do servidor.
#
# Onde gerar o token:
#   https://pypi.org/manage/account/token/
#   Agora que o projeto "datajud-mcp" já existe, prefira o escopo
#   restrito a ele, em vez de "Entire account".
#
# Como usar na hora de publicar:
#   TWINE_USERNAME=__token__ TWINE_PASSWORD="$PYPI_TOKEN" \
#     uvx twine upload dist/*
#
# O token começa com "pypi-". Cole o valor completo.

PYPI_TOKEN=


# =====================================================================
# 3. Hospedagem do servidor remoto (VPS / Dokploy)  —  FASE FUTURA
# =====================================================================
# Preencha quando for colocar o servidor no ar para uso público.
# É o que destrava o ChatGPT, que só conecta a servidores MCP remotos,
# e o público que não quer instalar nada na própria máquina.

# Endereço em que o servidor vai escutar dentro do contêiner.
# Use 0.0.0.0 para aceitar conexões externas; 127.0.0.1 só aceita local.
DATAJUD_MCP_HOST=0.0.0.0
DATAJUD_MCP_PORT=8000

# Domínio público que vai apontar para o servidor, com HTTPS.
# Exemplo: datajud.seudominio.com.br
# A URL que você informa no ChatGPT/Claude é este domínio + /mcp
DATAJUD_MCP_DOMINIO=

# Painel Dokploy da sua VPS Hostinger.
# URL do painel, ex.: https://painel.seudominio.com.br
DOKPLOY_URL=

# Token de API do Dokploy.
# Onde gerar: painel do Dokploy -> Settings -> API / Tokens
DOKPLOY_TOKEN=

# ID do projeto no Dokploy onde a aplicação será criada.
# Aparece na URL do projeto dentro do painel.
DOKPLOY_PROJETO_ID=
